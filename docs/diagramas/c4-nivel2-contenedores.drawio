        </mxCell>
        <mxCell id="d2-nota" value="Pendiente: se dibuja después de ADR-001 (estilo de arquitectura) y ADR-002 (mecanismo de comunicación). Borrar esta nota al dibujar el diagrama." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontStyle=2;fontColor=#000000;dashed=1;strokeColor=#000000;fillColor=none;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="700" height="60" as="geometry" />
