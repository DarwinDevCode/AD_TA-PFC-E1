        <mxCell id="n2-rel-persona" value="[Verbo]&lt;br&gt;[medio]" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n2-persona" target="n2-servicio-a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n2-rel-sinc" value="I-01: [verbo y qué intercambia]&lt;br&gt;[Sincrónica] [REST | gRPC]" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n2-servicio-a" target="n2-servicio-b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
